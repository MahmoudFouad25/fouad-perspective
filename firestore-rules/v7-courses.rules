rules_version = '2';
// نسخة القواعد ٧ — الكورسات (٢٥ أكتوبر ٢٠٢٦). مبنية على النسخة ٦، والفرق في الكورسات بس:
//   courses  الكل يقرا (صفحات الكورسات والطلاب)، والكتابة للأدمن بس.
//            الاستثناء الوحيد: زائر يضيف رأيه (شهادة) جديدة على صفحة الكورس، من غير ما يغيّر أي حاجة تانية
//            ومن غير ما يعلّمها «موثقة» أو «مميزة».
//   كانت الكورسات داخلة في القاعدة العامة اللي آخر الملف، ودي كانت بتسمح لأي حد يكتب فيها.
//
// نسخة القواعد ٦ — ملف العميل (٢٤ أكتوبر ٢٠٢٦). مبنية على النسخة ٥، والفرق ٣ مجموعات بس:
//   client_vault  نسخة الباسورد المقفولة: محدش يقراها من المتصفح خالص (السيرفر بس)
//   client_log    سجل كل اللي اتعمل في ملف العميل: للأدمن بس
//   client_notes  ملاحظاتك على العميل: للأدمن بس
// (النسخة ٥: receipts للأدمن بس، و app_secrets محدش يقراه من المتصفح)

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in [
     'admin@fouad-academy.com'
   ];
    }

    match /sessions/{sid} {
      allow read: if true;
      allow write: if isAdmin();

      match /participants/{slug} {
        function ownerUid()  { return resource.data.get('uid', ''); }
        function isOwner()   { return request.auth != null
                               && (ownerUid() == '' || ownerUid() == request.auth.uid); }
        function safeFields() {
          return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answers','manual','lastSeenAt','needsMinuteAt',
                           'needsMinuteHandled','uid','name']);
        }
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.slug == slug;
        allow read:   if isAdmin() || isOwner();
        allow update: if isAdmin() || (isOwner() && safeFields());
        allow delete: if isAdmin();
      }

      match /thresholdCards/{cid} {
        allow create: if request.auth != null
                      && request.resource.data.keys()
                         .hasOnly(['said','replied','hourBucket','flag','shown'])
                      && request.resource.data.said is string
                      && request.resource.data.said.size() < 4000
                      && request.resource.data.replied is string
                      && request.resource.data.replied.size() < 4000;
        allow read, update, delete: if isAdmin();
      }

      match /derived/{doc} {
        allow read, write: if isAdmin();
      }
    }

    match /training/{sessionId} {
      allow read, write: if true;
      match /participants/{participantId} {
        allow read, write: if true;
        match /responses/{responseId} {
          allow read, write: if true;
        }
      }
      match /groups/{groupId} {
        allow read, write: if true;
      }
      match /charters/{charterId} {
        allow read, write: if true;
      }
    }

    function rtRid(rid) { return rid.matches('^[A-Za-z0-9]{20,40}_[A-Za-z0-9]{6,40}$'); }

    match /rt_links/{token} {
      allow get: if true;
      allow list, write: if isAdmin();
      match /private/{doc} {
        allow get: if true;
        allow list, write: if isAdmin();
      }
    }
    match /rt_envelopes/{letter} {
      allow get: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1
      );
      allow list, create, delete: if isAdmin();
    }
    match /rt_responses/{rid} {
      allow get: if isAdmin() || rtRid(rid);
      allow create: if rtRid(rid)
        && rid == request.resource.data.uid + '_' + request.resource.data.token
        && exists(/databases/$(database)/documents/rt_links/$(request.resource.data.token))
        && request.resource.data.letter == get(/databases/$(database)/documents/rt_links/$(request.resource.data.token)).data.letter;
      allow update: if isAdmin() || (
        rtRid(rid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.letter == resource.data.letter
      );
      allow list, delete: if isAdmin();
    }
    match /rt_people/{rid} {
      allow create: if rtRid(rid)
        && request.resource.data.keys().hasOnly(['uid','token','letter','name','contact','createdAt','linkedTo'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.contact is string && request.resource.data.contact.size() < 200;
      allow read, update, delete: if isAdmin();
    }
    match /rt_key/{doc} {
      allow read, write: if isAdmin();
    }
    match /rt_settings/{doc} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    function wqAdmin() {
      return request.auth != null
             && request.auth.token.email in ['admin@fouad-academy.com'];
    }
    function wqOwns(bookId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/wq_ent/$(request.auth.uid + '_' + bookId))
             && get(/databases/$(database)/documents/wq_ent/$(request.auth.uid + '_' + bookId)).data.get('active', true) == true;
    }

    match /wq_books/{bookId} {
      allow read: if true;
      allow write: if wqAdmin();
      match /chapters/{chId} {
        allow get: if wqAdmin()
                   || (resource.data.status == 'published'
                       && (resource.data.free == true || wqOwns(bookId)));
        allow list, write: if wqAdmin();
      }
      match /history/{h} {
        allow read, write: if wqAdmin();
      }
    }

    match /wq_ent/{eid} {
      allow get: if wqAdmin()
                 || (request.auth != null && eid.matches(request.auth.uid + '_.*'));
      allow list, update, delete: if wqAdmin();
      allow create: if wqAdmin() || (
            request.auth != null
         && request.resource.data.uid == request.auth.uid
         && eid == request.auth.uid + '_' + request.resource.data.book
         && request.resource.data.via == 'code'
         && request.resource.data.get('active', true) == true
         && getAfter(/databases/$(database)/documents/wq_codes/$(request.resource.data.code)).data.usedBy == request.auth.uid
         && getAfter(/databases/$(database)/documents/wq_codes/$(request.resource.data.code)).data.book == request.resource.data.book);
    }

    match /wq_codes/{code} {
      allow get: if request.auth != null;
      allow list, create, delete: if wqAdmin();
      allow update: if wqAdmin() || (
            request.auth != null
         && resource.data.usedBy == null
         && resource.data.get('disabled', false) == false
         && request.resource.data.usedBy == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'usedEmail']));
    }

    match /wq_orders/{oid} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['uid','email','name','book','method','methodName','amount','amountNum','priceBase','offer','offerId','coupon','bundle','bundleId','gift','giftTo','giftMsg','phone','ref','note','receipt','status','at','log']);
      allow read: if wqAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if wqAdmin();
    }

    match /wq_coupons/{code} {
      allow get: if request.auth != null;
      allow list, write: if wqAdmin();
    }

    match /wq_receipts/{oid} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','order','img','at'])
                    && request.resource.data.img is string
                    && request.resource.data.img.size() < 1000000
                    && getAfter(/databases/$(database)/documents/wq_orders/$(oid)).data.uid == request.auth.uid;
      allow get: if wqAdmin()
                 || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, update, delete: if wqAdmin();
    }

    match /wq_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, list: if wqAdmin();
      match /data/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ===================== ورشة «الميزان» =====================
    // الأدمن الرئيسي = isAdmin() (admin@fouad-academy.com): كل الجلسات + بيضيف الميسّرين.
    // الميسّر = إيميله متسجّل في mizan_staff ومش موقوف: بيعمل جلساته، وبيتحكم فيها
    //   وفي الجلسات اللي صاحبها ضافه فيها «شريك» (editors). وأي جلسة تانية: قراية بس.
    function mzEmail() {
      return (request.auth != null && request.auth.token.email != null) ? request.auth.token.email.lower() : '';
    }
    function mzStaff() {
      return mzEmail() != ''
        && exists(/databases/$(database)/documents/mizan_staff/$(mzEmail()))
        && get(/databases/$(database)/documents/mizan_staff/$(mzEmail())).data.get('active', true) == true;
    }
    function mzSessCan(d) {
      return isAdmin()
        || (mzStaff() && (d.get('owner', '') == mzEmail() || mzEmail() in d.get('editors', [])));
    }
    function mzCan(sid) {
      return isAdmin()
        || (mzStaff()
            && exists(/databases/$(database)/documents/mizan/$(sid))
            && mzSessCan(get(/databases/$(database)/documents/mizan/$(sid)).data));
    }

    // الفريق: الأدمن بس يضيف ويوقف. والميسّر يقرا (عشان يشوف حسابه ويختار شركاءه).
    match /mizan_staff/{email} {
      allow get: if isAdmin() || mzEmail() == email || mzStaff();
      allow list: if isAdmin() || mzStaff();
      allow write: if isAdmin();
    }

    // كلمة السر الحالية للميسّر: الأدمن الرئيسي بس اللي يقراها.
    // الميسّر بيكتب كلمة السر بتاعته هو بس (مع كل دخول أو تغيير)، وما يقدرش يقراها ولا يقرا بتاعة حد.
    match /mizan_staff_pw/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        || (mzStaff() && mzEmail() == email
            && request.resource.data.keys().hasOnly(['pw', 'at'])
            && request.resource.data.pw is string
            && request.resource.data.pw.size() < 200);
    }

    match /mizan/{sid} {
      // مستند الجلسة: الكل يقرا (الموبايلات وشاشة العرض حتى من غير دخول).
      allow read: if true;
      // الميسّر يعمل جلسة باسمه هو بس.
      allow create: if isAdmin()
        || (mzStaff() && request.resource.data.get('owner', '') == mzEmail());
      // صاحبها أو شريكه يحرّكها. محدش غير الأدمن يغيّر صاحبها، ومحدش غير صاحبها يغيّر الشركاء.
      allow update: if isAdmin()
        || (mzSessCan(resource.data)
            && request.resource.data.get('owner', '') == resource.data.get('owner', '')
            && (request.resource.data.get('editors', []) == resource.data.get('editors', [])
                || resource.data.get('owner', '') == mzEmail()));
      allow delete: if isAdmin()
        || (mzStaff() && resource.data.get('owner', '') == mzEmail());

      // الأعداد المجمّعة (أرقام بس، من غير أسماء)
      match /pub/{doc} {
        allow read: if true;
        allow write: if mzCan(sid);
      }

      // المشارك: اسمه الأول + مدته + طلب «محتاج حد يكلمني»
      match /people/{uid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || mzCan(sid);
        allow create, update: if (request.auth != null && request.auth.uid == uid
                                  && request.resource.data.size() <= 12)
                              || mzCan(sid);
        allow delete: if (request.auth != null && request.auth.uid == uid) || mzCan(sid);
      }

      // التصويت المجهول (اللي بيتعرض أعداد) + التقييم في الآخر
      match /votes/{uid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || mzCan(sid);
        allow create, update: if (request.auth != null && request.auth.uid == uid
                                  && request.resource.data.size() <= 40)
                              || mzCan(sid);
        allow delete: if (request.auth != null && request.auth.uid == uid) || mzCan(sid);
      }
    }
    // ============================================================

    // ============ «مقياس مسارات الطاقة» النسخة ٢ — maqyas_axes_v2 ============
    // الوثيقة لصاحبها بس: إيميل حساب الدخول = إيميل users/{userId}.
    // العميل ما يكتبش حقول الكوتش، وبعد ما يخلّص يقيّم بس (أو يغيّر صيغة الكلام: address). والأدمن يكتب حقول الكوتش بس. ومحدش يمسح.
    function isAxv2Admin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@fouad-academy.com'];
    }
    function isAxv2Owner(userId) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.personalInfo.email.lower()
             == request.auth.token.email.lower();
    }

    match /maqyas_axes_v2/{userId} {
      allow get:    if isAxv2Admin() || isAxv2Owner(userId);
      allow list:   if isAxv2Admin();

      allow create: if isAxv2Owner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status in ['شغال', 'خلص']
        && !request.resource.data.keys().hasAny(['override', 'resultHistory', 'adminUpdatedAt', 'adminNote']);

      allow update: if
        (isAxv2Owner(userId)
          && resource.data.status == 'شغال'
          && request.resource.data.userId == userId
          && request.resource.data.authUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['override', 'resultHistory', 'adminUpdatedAt', 'adminNote']))
        || (isAxv2Owner(userId)
          && resource.data.status == 'خلص'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reportViewedAt', 'purchase', 'updatedAt', 'address', 'addressAt']))
        || (isAxv2Admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['override', 'result', 'summary', 'resultHistory', 'engineVersion', 'configVersion', 'textsVersion', 'adminUpdatedAt', 'adminNote']));

      allow delete: if false;
    }
    // ============================================================

    // ============ «ميزان المتطوع» — mizan_scale/{CODE} ============
    // الكود هو رقم الوثيقة. اللي معاه الكود يفتح الوثيقة دي بس (get)، ومحدش غير الأدمن يعرض القايمة (list).
    // المتطوع مش داخل بأي حساب، فالحماية كلها في: الكود عشوائي ومستحيل يتخمّن، والقايمة مقفولة،
    // والحقول اللي يقدر يكتبها محددة، وبعد ما يخلّص ما يقدرش يغيّر إجاباته ولا نتيجته.
    function mzsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function mzsVolunteerKeys() {
      return ['v', 'address', 'addressAt', 'status', 'screen', 'device', 'questionsVersion', 'questionsHash', 'qVersion',
              'startedAt', 'updatedAtMs', 'finishedAt', 'period', 'client', 'st', 'adaptive',
              'updatedAt', 'lastPush', 'result', 'summary', 'engineVersion', 'configVersion', 'textsVersion', 'computedAt',
              'rating', 'reportViewedAt'];
    }
    // بعد «خلص»: التقييم، وإنه فتح التقرير، والصيغة بس
    function mzsAfterDoneKeys() {
      return ['rating', 'reportViewedAt', 'address', 'addressAt', 'updatedAt', 'updatedAtMs', 'lastPush'];
    }

    match /mizan_scale/{code} {
      allow get: if true;
      allow list: if isAdmin();
      // الوثيقة بيعملها الأدمن بس (مع الكود). يعني كود غلط ما يقدرش يعمل وثيقة جديدة.
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.get('revoked', false) != true
            && mzsChanged().hasOnly(mzsVolunteerKeys())
            && (resource.data.get('status', '') != 'خلص'
                || mzsChanged().hasOnly(mzsAfterDoneKeys())));
    }
    // ============================================================

    // ============ «إنسان» — آراء القرّاء قبل النشر — insan_raay/{rid} ============
    // الزائر مش داخل بأي حساب. كل زائر له وثيقة برقم عشوائي طويل محفوظ في جهازه.
    // يقدر يكتب وثيقته بس (بالحقول المسموحة وبأطوال محددة)، وما يقدرش يقرا أي حاجة.
    // القراية والمسح للأدمن الرئيسي بس (صفحة insan-raay/admin.html).
    function irKeys() {
      return ['name', 'phone', 'address', 'feel', 'reactions', 'notes', 'oneLine', 'subtitles',
              'secDar', 'secSaey', 'secTina', 'status', 'step', 'startedAt', 'updatedAt', 'finishedAt', 'ua', 'v'];
    }
    function irStr(d, k, n) {
      return !(k in d) || (d[k] is string && d[k].size() <= n);
    }
    function irValid(d) {
      return d.keys().hasOnly(irKeys())
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && irStr(d, 'address', 2) && irStr(d, 'feel', 40) && irStr(d, 'status', 20) && irStr(d, 'ua', 200)
        && irStr(d, 'oneLine', 2000) && irStr(d, 'secDar', 600) && irStr(d, 'secSaey', 600) && irStr(d, 'secTina', 600)
        && (!('subtitles' in d) || (d.subtitles is list && d.subtitles.size() <= 3))
        && (!('reactions' in d) || (d.reactions is map && d.reactions.size() <= 12))
        && (!('notes' in d) || (d.notes is map && d.notes.size() <= 12));
    }

    match /insan_raay/{rid} {
      allow create, update: if rid.matches('^[A-Za-z0-9]{20,40}$') && irValid(request.resource.data);
      allow read, delete: if isAdmin();
    }
    // ============================================================

    // ============ نظام الحجز — المرحلة ١ (آمنة النهارده، ومش بتكسر أي صفحة) ============
    // اتكتبت ٢١ أكتوبر ٢٠٢٦ بعد جرد كل الصفحات اللي بتلمس المجموعات دي.

    // محادثات التليجرام والردود الجاهزة: زي النهارده بالظبط (للأدمن بس)، بس مكتوبة صريحة
    // علشان ما تعتمدش على السطر العام اللي في الآخر.
    match /telegramChats/{chatId}/{rest=**} {
      allow read, write: if isAdmin();
    }
    match /telegramChats/{chatId} {
      allow read, write: if isAdmin();
    }
    match /quickReplies/{id} {
      allow read, write: if isAdmin();
    }

    // ---- الكوبونات ----
    // الثغرة النهارده: أي حد يقدر يعمل كوبون بأي قيمة، أو يعدّل قيمة كوبون موجود، أو يمسح كوبونات الأدمن.
    // صفحات الحجز العامة: بتدوّر على الكوبون بالكود (limit 1)، وبتسجّل إنه اتستعمل.
    // «كورساتي»: العميل بيحوّل نقاط المحفظة لكوبون (كل ١ جنيه = ١٠ نقاط)، ويقدر يلغيه لو لسه ما اتستعملش.
    // صفحة بناء الكورسات: الأدمن (داخل بحسابه) بيعمل ويعدّل ويمسح.
    // أقصى قيمة لكوبون المحفظة: محمود بيحددها من admin/coupon-settings.html
    // (وثيقة app_settings/wallet_coupons). لو فيه فترة شغالة دلوقتي يبقى حدها، غير كده الحد العادي.
    // ولو الوثيقة مش موجودة لسه: ٢٠٠٠ جنيه (نفس الرقم في js/wallet-coupon-limit.js).
    function cpLimitPath() { return /databases/$(database)/documents/app_settings/wallet_coupons; }
    function cpMaxFrom(s) {
      return (s.get('periodMax', null) is number
              && s.get('periodFrom', null) is timestamp
              && s.get('periodTo', null) is timestamp
              && request.time >= s.periodFrom
              && request.time < s.periodTo)
             ? s.periodMax
             : s.get('defaultMax', 2000);
    }
    function cpWalletMax() {
      return exists(cpLimitPath()) ? cpMaxFrom(get(cpLimitPath()).data) : 2000;
    }
    match /app_settings/{doc} {
      allow get: if true;                 // الصفحات بتعرض الحد للعميل
      allow list, write: if isAdmin();
      match /history/{h} {
        allow read, write: if isAdmin();
      }
    }
    match /coupons/{id} {
      allow get: if true;
      // البحث بالكود (/coupon/check) وقايمة كوبونات المحفظة (/wallet/coupons) بقوا على السيرفر.
      allow list: if isAdmin();

      // كوبونات المحفظة بتتعمل على السيرفر بس (البوت، /wallet/coupon) في نفس العملية اللي بتخصم النقاط.
      allow create: if isAdmin();

      // تسجيل الاستعمال على السيرفر بس (/coupon/redeem): على حجز حقيقي فيه الكوبون، مرة واحدة.
      allow update: if isAdmin();

      // الإلغاء ورجوع النقاط على السيرفر بس (البوت، /wallet/coupon-cancel).
      allow delete: if isAdmin();
    }
    // ============================================================

    // ============ نظام الحجز — المرحلة ٢ (بعد ما صفحات الأدمن تعمل دخول بحساب الأدمن) ============
    // ما تتنشرش غير بعد ما:
    //   ١) book-bot-online.html و bookings/creat&allow.html و edite-user.html يعملوا دخول فايربيز ويتأكدوا من إيميل الأدمن.
    //   ٢) نتأكد من كود البوت (telegramBot) إنه بيكتب بـ Admin SDK (القواعد ما بتطبقش عليه).
    //   ٣) النسخ القديمة اللي في admin/ (book-spare, d, managebookings, managebooking2, bookings/back-up ...) تتمسح أو تتقفل.

    // ---- ملفات الطلاب الأفراد: مفيش عميل ولا صفحة عامة بتقراها. للأدمن بس. ----
    match /individualStudents/{id}/{rest=**} {
      allow read, write: if isAdmin();
    }
    match /individualStudents/{id} {
      allow read, write: if isAdmin();
    }

    // ---- الحجوزات المؤقتة ----
    // صفحات البيع العامة بتعمل حجز جديد من غير دخول (status = pending، ومن غير أي حقل دفع أو تحويل).
    // صفحة «غيّر خطة الدفع» (BC.html) بتدوّر بالرقم أو بكود التليجرام (limit 1) وبتغيّر الخطة قبل الدفع بس.
    function tbAdminOnlyKeys() {
      return ['paymentConfirmed','paidAt','transferredTo','transferredAt','transferredToPage',
              'grantStatus','confirmedBy','confirmedAt','adminNotes','telegramChatId','telegramConnected',
              'automationWorkflow','paymentRejected','receiptRequested','paymentDetails','paymentInfo',
              'userId','accountCreated','courseAssigned'];
    }
    match /tempBookings/{id} {
      allow create: if isAdmin() || (
           request.resource.data.get('status', 'pending') == 'pending'
        && !request.resource.data.keys().hasAny(tbAdminOnlyKeys()));

      allow get: if true;                                   // مؤقت: صفحة BC.html. يتقفل لما البحث يتنقل للسيرفر
      allow list: if isAdmin() || request.query.limit <= 1;  // مؤقت: يمنع تنزيل كل الحجوزات مرة واحدة

      allow update: if isAdmin() || (
           resource.data.get('status', 'pending') in ['pending', 'confirmed']    // قبل الدفع بس
        && request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['lastUpdated','planChangedAt','planChangedBy','planChangeMethod','pricing',
              'discounts','payment','paymentDetails','totalSavings','totalSavingsText']));

      allow delete: if isAdmin();
      match /{sub=**} {
        allow read, write: if isAdmin();
      }
    }
    // ============================================================

    // ============ ملفات العملاء — المرحلة ٤ (٢٢ أكتوبر ٢٠٢٦) ============
    // كل عميل يشوف ملفه بس، والأدمن يشوف الكل. العميل يعرف بحساب الدخول:
    // auth.authUid (اللي السيرفر بيسجّله) أو الإيميل نفسه.
    function usrOwns(d) {
      return request.auth != null && (
           d.get('auth', {}).get('authUid', '') == request.auth.uid
        || (request.auth.token.get('email', '') != ''
            && d.get('personalInfo', {}).get('email', '') == request.auth.token.get('email', '').lower()));
    }
    function usrDoc(id) { return get(/databases/$(database)/documents/users/$(id)).data; }
    function usrOwnsId(id) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(id))
        && usrOwns(usrDoc(id));
    }
    // العميل يعدّل في ملفه التقدم ونقاط الرحلة والشارات وإحصائيات الدخول وعنوان المخاطبة.
    // ما يقدرش يلمس: الكورسات، وحالة الحساب، والفلوس، ونقاط المحفظة (السيرفر بس)، والحجوزات، والبيانات الإدارية، وأسرار الدخول.
    function usrOwnerUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      let a0 = before.get('auth', {});
      let a1 = after.get('auth', {});
      let p0 = before.get('personalInfo', {});
      let p1 = after.get('personalInfo', {});
      return !after.diff(before).affectedKeys().hasAny(['enrollments','accountStatus','financial','bookingHistory',
                 'metadata','id','labels','labelsMetadata','referralProgram','walletPoints'])
        && a1.diff(a0).affectedKeys().hasOnly(['lastLogin','loginCount','lastAuthMethod','lastLoginSource'])
        && p1.diff(p0).affectedKeys().hasOnly(['address']);
    }
    match /users/{userId} {
      allow get, list: if isAdmin() || usrOwns(resource.data);
      allow update: if isAdmin() || (usrOwns(resource.data) && usrOwnerUpdateOk());
      allow create, delete: if isAdmin();      // الحسابات بتتعمل من صفحات الأدمن أو كابينة Reignite
      // السجلات الفرعية: awakening_progress، pillarProgress، courseProgress، financial …
      // لازم /{subColl}/{subDoc=**} مش /{sub=**}: الأخيرة بتطابق ملف العميل نفسه كمان (صفر أجزاء)
      // وكانت هتسمح للعميل يعدّل أي حاجة في ملفه.
      match /{subColl}/{subDoc=**} {
        allow read, write: if isAdmin() || usrOwnsId(userId);
      }
    }

    // طلبات التسجيل في Reignite: أي حد يبعت طلب بالشكل ده بس، والأدمن بيقبل أو يرفض من الكابينة.
    match /reignite_requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','whatsapp','status','source','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.source == 'reignite-signup'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^[0-9]{9,20}$');
      allow read, update, delete: if isAdmin();
    }

    // سجل Reignite: العميل يقرا سطره بس (علشان يعرف مجموعته)، والأدمن الكل.
    match /reignite_roster/{uid} {
      allow get: if isAdmin() || usrOwnsId(uid);
      allow list, write: if isAdmin();
    }
    // سجل نقاط الدروس (السيرفر بيكتبه) وعدّاد المحاولات: محدش يكتب فيهم من المتصفح.
    match /points_ledger/{id} {
      allow read, write: if isAdmin();      // السيرفر بيكتب، والأدمن للتسجيل الأوّلي بس
    }
    match /auth_attempts/{id} {
      allow read, write: if false;
    }
    match /reignite_cohorts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // إيصالات الأقساط (المرحلة ٧): الأدمن يراجع ويقرر، والبوت بيكتب من السيرفر.
    match /receipts/{id} {
      allow read, write: if isAdmin();
    }
    // مفاتيح السيرفر: من السيرفر بس.
    match /app_secrets/{id} {
      allow read, write: if false;
    }
    // ملف العميل (المرحلة ١٣):
    // الخزنة: نسخة مقفولة من الباسورد. السيرفر بس (البوت بيعرضها بعد الرقم السري).
    match /client_vault/{userId} {
      allow read, write: if false;
    }
    // سجل العميل وملاحظاتك عليه: للأدمن بس (العميل نفسه ما يشوفهمش).
    match /client_log/{userId} {
      allow read, write: if isAdmin();
    }
    match /client_notes/{userId} {
      allow read, write: if isAdmin();
    }

    // ---- الكورسات (النسخة ٧) ----
    // شهادة واحدة جديدة في أول القايمة، والباقي زي ما هو، ومش موثقة ولا مميزة
    function crsOldTestimonials() {
      return resource.data.get('testimonials', {}).get('testimonials', []);
    }
    function crsTestimonialAppend() {
      let nt = request.resource.data.get('testimonials', {}).get('testimonials', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testimonials'])
          && request.resource.data.testimonials.diff(resource.data.get('testimonials', {})).affectedKeys().hasOnly(['testimonials'])
          && nt is list
          && nt.size() == crsOldTestimonials().size() + 1
          && nt.size() <= 2000
          && nt.hasAll(crsOldTestimonials())
          && nt[0] is map
          && nt[0].get('verified', false) == false
          && nt[0].get('highlight', false) == false;
    }
    match /courses/{courseId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || crsTestimonialAppend();
      match /{rest=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    // ============================================================

    match /{collection}/{doc=**} {
      allow read, write: if (collection in ['sessions','maqyas_axes_v2','insan_raay','telegramChats','quickReplies','coupons','app_settings','tempBookings','individualStudents','users','reignite_requests','reignite_roster','reignite_cohorts','points_ledger','auth_attempts','receipts','app_secrets','client_vault','client_log','client_notes','courses'] || collection.matches('mizan.*') || collection.matches('rt_.*') || collection.matches('wq_.*'))
                            ? false
                            : ((collection != 'telegramChats'
                                && collection != 'quickReplies')
                               || isAdmin());
    }
  }
}

// ==================== اختبارات Rules Playground قبل النشر ====================
//  (النسخة ٧) update courses/<كورس> من غير دخول، يغيّر title        ← يترفض
//  (النسخة ٧) get courses/<كورس> من غير دخول                         ← يتقبل
//  (النسخة ٧) update courses/<كورس> بالأدمن                          ← يتقبل
//  ١) update users/<عميل> بإيميله، يغيّر walletPoints        ← يترفض
//  ٢) update users/<عميل> بإيميله، يغيّر journeyPoints       ← يتقبل
//  ٣) list coupons (أي حد غير الأدمن)                       ← يترفض
//  ٤) update coupons/<أي كوبون> من غير دخول                 ← يترفض
//  ٥) get coupons/<كوبون> من غير دخول                       ← يتقبل (الصفحات بتتأكد بالرقم)
//  ٦) get points_ledger/<أي حاجة> داخل بإيميل عميل          ← يترفض
//  ٧) get receipts/<أي حاجة> من غير دخول                     ← يترفض
//  ٨) get receipts/<أي حاجة> داخل بإيميل عميل                ← يترفض
//  ٩) get receipts/<أي حاجة> داخل بإيميل الأدمن               ← يتقبل
// ١٠) get app_secrets/installments_cron داخل بإيميل الأدمن     ← يترفض
// ١١) get client_vault/<أي عميل> داخل بإيميل الأدمن           ← يترفض
// ١٢) get client_notes/<عميل> داخل بإيميل العميل نفسه          ← يترفض
// ١٣) get client_log/<عميل> داخل بإيميل الأدمن                 ← يتقبل
