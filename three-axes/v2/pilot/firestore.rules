// =====================================================================
// قواعد الأمان للنسخة التجريبية من «مقياس المحاور ٢» — /maqyas_axes_v2_pilot/{uid}
// ---------------------------------------------------------------------
// ⚑ ما تستبدلش قواعد المشروع كلها بالملف ده. ده «مقطعين» بيتلصقوا جوّه الملف الموجود.
//   الخطوات بالتفصيل في README.md في نفس الفولدر.
//
// ⚑ فايربيز بيجمع القواعد بـ«أو»: لو فيه قاعدة عامة في آخر الملف بتفتح كل المجموعات
//   (match /{collection}/{doc=**} … if true)، لازم تضيف المجموعة دي للاستثناءات بتاعتها،
//   وإلا أي حد هيقدر يقرا ويكتب ويمسح إجابات المشاركين.
//
// ⚑ الإيميل لازم يبقى نفس اللي في pilot/config.js (AXP_ADMINS) بالحرف وبحروف صغيرة.
// =====================================================================

    // ── (١) الصق ده جوّه  match /databases/{database}/documents { … }  وقبل القاعدة العامة ──
    function isAxpAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@fouad-academy.com'];
    }

    match /maqyas_axes_v2_pilot/{uid} {
      // المشارك (دخول مجهول): يقرا ويكتب وثيقته هو بس. والأدمن يقرا الكل.
      allow get:    if isAxpAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list:   if isAxpAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      // بعد ما يخلّص (الحالة «خلص») الوثيقة بتتقفل.
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && resource.data.status != 'خلص';
      // محدش يمسح من الصفحات. المسح من Firebase Console بس.
      allow delete: if false;
    }

    // ── (٢) في القاعدة العامة (لو موجودة)، زوّد المجموعة على قايمة الاستثناءات. مثال: ──
    //
    //   قبل:  allow read, write: if (collection == 'sessions' || collection.matches('rt_.*'))
    //   بعد:  allow read, write: if (collection == 'sessions' || collection.matches('rt_.*')
    //                                || collection == 'maqyas_axes_v2_pilot')
    //
    //   (ولو فيه match /{document=**} بـ if true، دي بتفتح كل حاجة، ولازم تتشال أو تتقفل.)
