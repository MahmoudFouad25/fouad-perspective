rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in [
     'admin@fouad-academy.com'
   ];
    }

    match /sessions/{sid} {
      allow read: if true;
      allow write: if isAdmin();

      match /participants/{slug} {
        function ownerUid()  { return resource.data.get('uid', ''); }
        function isOwner()   { return request.auth != null
                               && (ownerUid() == '' || ownerUid() == request.auth.uid); }
        function safeFields() {
          return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answers','manual','lastSeenAt','needsMinuteAt',
                           'needsMinuteHandled','uid','name']);
        }
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.slug == slug;
        allow read:   if isAdmin() || isOwner();
        allow update: if isAdmin() || (isOwner() && safeFields());
        allow delete: if isAdmin();
      }

      match /thresholdCards/{cid} {
        allow create: if request.auth != null
                      && request.resource.data.keys()
                         .hasOnly(['said','replied','hourBucket','flag','shown'])
                      && request.resource.data.said is string
                      && request.resource.data.said.size() < 4000
                      && request.resource.data.replied is string
                      && request.resource.data.replied.size() < 4000;
        allow read, update, delete: if isAdmin();
      }

      match /derived/{doc} {
        allow read, write: if isAdmin();
      }
    }

    match /training/{sessionId} {
      allow read, write: if true;
      match /participants/{participantId} {
        allow read, write: if true;
        match /responses/{responseId} {
          allow read, write: if true;
        }
      }
      match /groups/{groupId} {
        allow read, write: if true;
      }
      match /charters/{charterId} {
        allow read, write: if true;
      }
    }

    function rtRid(rid) { return rid.matches('^[A-Za-z0-9]{20,40}_[A-Za-z0-9]{6,40}$'); }

    match /rt_links/{token} {
      allow get: if true;
      allow list, write: if isAdmin();
      match /private/{doc} {
        allow get: if true;
        allow list, write: if isAdmin();
      }
    }
    match /rt_envelopes/{letter} {
      allow get: if true;
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['next'])
        && request.resource.data.next == resource.data.next + 1
      );
      allow list, create, delete: if isAdmin();
    }
    match /rt_responses/{rid} {
      allow get: if isAdmin() || rtRid(rid);
      allow create: if rtRid(rid)
        && rid == request.resource.data.uid + '_' + request.resource.data.token
        && exists(/databases/$(database)/documents/rt_links/$(request.resource.data.token))
        && request.resource.data.letter == get(/databases/$(database)/documents/rt_links/$(request.resource.data.token)).data.letter;
      allow update: if isAdmin() || (
        rtRid(rid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.token == resource.data.token
        && request.resource.data.letter == resource.data.letter
      );
      allow list, delete: if isAdmin();
    }
    match /rt_people/{rid} {
      allow create: if rtRid(rid)
        && request.resource.data.keys().hasOnly(['uid','token','letter','name','contact','createdAt','linkedTo'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.contact is string && request.resource.data.contact.size() < 200;
      allow read, update, delete: if isAdmin();
    }
    match /rt_key/{doc} {
      allow read, write: if isAdmin();
    }
    match /rt_settings/{doc} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    function wqAdmin() {
      return request.auth != null
             && request.auth.token.email in ['admin@fouad-academy.com'];
    }
    function wqOwns(bookId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/wq_ent/$(request.auth.uid + '_' + bookId))
             && get(/databases/$(database)/documents/wq_ent/$(request.auth.uid + '_' + bookId)).data.get('active', true) == true;
    }

    match /wq_books/{bookId} {
      allow read: if true;
      allow write: if wqAdmin();
      match /chapters/{chId} {
        allow get: if wqAdmin()
                   || (resource.data.status == 'published'
                       && (resource.data.free == true || wqOwns(bookId)));
        allow list, write: if wqAdmin();
      }
      match /history/{h} {
        allow read, write: if wqAdmin();
      }
    }

    match /wq_ent/{eid} {
      allow get: if wqAdmin()
                 || (request.auth != null && eid.matches(request.auth.uid + '_.*'));
      allow list, update, delete: if wqAdmin();
      allow create: if wqAdmin() || (
            request.auth != null
         && request.resource.data.uid == request.auth.uid
         && eid == request.auth.uid + '_' + request.resource.data.book
         && request.resource.data.via == 'code'
         && request.resource.data.get('active', true) == true
         && getAfter(/databases/$(database)/documents/wq_codes/$(request.resource.data.code)).data.usedBy == request.auth.uid
         && getAfter(/databases/$(database)/documents/wq_codes/$(request.resource.data.code)).data.book == request.resource.data.book);
    }

    match /wq_codes/{code} {
      allow get: if request.auth != null;
      allow list, create, delete: if wqAdmin();
      allow update: if wqAdmin() || (
            request.auth != null
         && resource.data.usedBy == null
         && resource.data.get('disabled', false) == false
         && request.resource.data.usedBy == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'usedEmail']));
    }

    match /wq_orders/{oid} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['uid','email','name','book','method','methodName','amount','amountNum','priceBase','offer','offerId','coupon','bundle','bundleId','gift','giftTo','giftMsg','phone','ref','note','receipt','status','at','log']);
      allow read: if wqAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if wqAdmin();
    }

    match /wq_coupons/{code} {
      allow get: if request.auth != null;
      allow list, write: if wqAdmin();
    }

    match /wq_receipts/{oid} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid','order','img','at'])
                    && request.resource.data.img is string
                    && request.resource.data.img.size() < 1000000
                    && getAfter(/databases/$(database)/documents/wq_orders/$(oid)).data.uid == request.auth.uid;
      allow get: if wqAdmin()
                 || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, update, delete: if wqAdmin();
    }

    match /wq_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, list: if wqAdmin();
      match /data/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ===================== ورشة «الميزان» =====================
    match /mizan/{sid} {
      allow read: if true;
      allow write: if isAdmin();

      match /pub/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /people/{uid} {
        allow read: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid);
        allow create, update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.size() <= 12);
        allow delete: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid);
      }

      match /votes/{uid} {
        allow read: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid);
        allow create, update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.size() <= 40);
        allow delete: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid);
      }
    }
    // ============================================================

    // ============ «مقياس مسارات الطاقة» النسخة ٢ — maqyas_axes_v2 ============
    // الوثيقة لصاحبها بس: إيميل حساب الدخول = إيميل users/{userId}.
    // العميل ما يكتبش حقول الكوتش، وبعد ما يخلّص يقيّم بس (أو يغيّر صيغة الكلام: address). والأدمن يكتب حقول الكوتش بس. ومحدش يمسح.
    function isAxv2Admin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@fouad-academy.com'];
    }
    function isAxv2Owner(userId) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.personalInfo.email.lower()
             == request.auth.token.email.lower();
    }

    match /maqyas_axes_v2/{userId} {
      allow get:    if isAxv2Admin() || isAxv2Owner(userId);
      allow list:   if isAxv2Admin();

      allow create: if isAxv2Owner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status in ['شغال', 'خلص']
        && !request.resource.data.keys().hasAny(['override', 'resultHistory', 'adminUpdatedAt', 'adminNote']);

      allow update: if
        (isAxv2Owner(userId)
          && resource.data.status == 'شغال'
          && request.resource.data.userId == userId
          && request.resource.data.authUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['override', 'resultHistory', 'adminUpdatedAt', 'adminNote']))
        || (isAxv2Owner(userId)
          && resource.data.status == 'خلص'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reportViewedAt', 'purchase', 'updatedAt', 'address', 'addressAt']))
        || (isAxv2Admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['override', 'result', 'summary', 'resultHistory', 'engineVersion', 'configVersion', 'textsVersion', 'adminUpdatedAt', 'adminNote']));

      allow delete: if false;
    }
    // ============================================================

    match /{collection}/{doc=**} {
      allow read, write: if (collection == 'sessions' || collection == 'mizan' || collection.matches('rt_.*') || collection.matches('wq_.*') || collection == 'maqyas_axes_v2')
                            ? false
                            : ((collection != 'telegramChats'
                                && collection != 'quickReplies')
                               || isAdmin());
    }
  }
}