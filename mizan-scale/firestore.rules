// =====================================================================
// قواعد «ميزان المتطوع» — mizan_scale/{CODE}
// ---------------------------------------------------------------------
// ⚑ مسودة الخطوة ١: اتكتبت علشان الصفحة تتجرّب على نفس المنطق (tests/server.js بيطبّقه).
//   اختبارها على محاكي فايربيز الحقيقي ونشرها = الخطوة ٤. لحد ما تتنشر، الصفحة بتشتغل
//   وبتحفظ على الموبايل، ورسالة «فيه مشكلة في الحفظ عندنا» بتظهر برقم الخطأ permission-denied.
// ⚑ القاعدة العامة في آخر الملف الكامل (three-axes/v2/app/firestore.full.rules) بتستثني
//   collection.matches('mizan.*')، فـ mizan_scale من غير المقطع ده مقفولة على الكل. ده الآمن.
// ⚑ VOLUNTEER لازم تبقى نفس VOLUNTEER_KEYS في mizan-scale/app/shared.js بالحرف.
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@fouad-academy.com'];
    }

    // ===================== ميزان المتطوع =====================
    // الكود هو رقم الوثيقة. اللي معاه الكود يفتح الوثيقة دي بس (get)، ومحدش غير الأدمن يعرض القايمة (list).
    // المتطوع مش داخل بأي حساب، فالحماية كلها في: الكود عشوائي ومستحيل يتخمّن، والقايمة مقفولة،
    // والحقول اللي يقدر يكتبها محددة، وبعد ما يخلّص ما يقدرش يغيّر إجاباته ولا نتيجته.
    function mzsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function mzsVolunteerKeys() {
      return ['v', 'address', 'addressAt', 'status', 'screen', 'device', 'questionsVersion', 'questionsHash', 'qVersion',
              'startedAt', 'updatedAtMs', 'finishedAt', 'period', 'client', 'st', 'adaptive',
              'updatedAt', 'lastPush', 'result', 'summary', 'engineVersion', 'configVersion', 'textsVersion', 'computedAt',
              'rating', 'reportViewedAt'];
    }
    // بعد «خلص»: التقييم، وإنه فتح التقرير، والصيغة بس
    function mzsAfterDoneKeys() {
      return ['rating', 'reportViewedAt', 'address', 'addressAt', 'updatedAt', 'updatedAtMs', 'lastPush'];
    }

    match /mizan_scale/{code} {
      allow get: if true;
      allow list: if isAdmin();
      // الوثيقة بيعملها الأدمن بس (مع الكود). يعني كود غلط ما يقدرش يعمل وثيقة جديدة.
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.get('revoked', false) != true
            && mzsChanged().hasOnly(mzsVolunteerKeys())
            && (resource.data.get('status', '') != 'خلص'
                || mzsChanged().hasOnly(mzsAfterDoneKeys())));
    }
    // ============================================================
  }
}
