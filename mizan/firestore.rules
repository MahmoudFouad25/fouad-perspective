// =====================================================================
// قواعد الأمان لورشة «الميزان» — mizan/{sessionId}
// ---------------------------------------------------------------------
// ⚑ متستبدلش قواعد المشروع كلها بالملف ده!
//   انسخ الدالة isMizanAdmin ومقطع match /mizan/... وحطهم جوّه
//   match /databases/{database}/documents { ... } في ملف القواعد الأساسي،
//   جنب باقي المقاطع اللي موجودة. وبعدين Publish.
// ⚑ الإيميل لازم يبقى نفس اللي في mizan/assets/config.js بالحرف (حروف صغيرة).
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMizanAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['admin@fouad-academy.com'];
    }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }

    match /mizan/{sid} {
      // مستند الجلسة: الكل يقرا (الموبايلات وشاشة العرض حتى من غير دخول)، والأدمن بس يكتب.
      allow read: if true;
      allow write: if isMizanAdmin();

      // الأعداد المجمّعة (أرقام بس، من غير أسماء)
      match /pub/{doc} {
        allow read: if true;
        allow write: if isMizanAdmin();
      }

      // المشارك: اسمه الأول + مدته + طلب «محتاج حد يكلمني»
      match /people/{uid} {
        allow read: if isMizanAdmin() || isSelf(uid);
        allow create, update: if isMizanAdmin() || (isSelf(uid) && request.resource.data.size() <= 12);
        allow delete: if isMizanAdmin() || isSelf(uid);
      }

      // التصويت المجهول (اللي بيتعرض أعداد) + التقييم في الآخر
      match /votes/{uid} {
        allow read: if isMizanAdmin() || isSelf(uid);
        allow create, update: if isMizanAdmin() || (isSelf(uid) && request.resource.data.size() <= 40);
        allow delete: if isMizanAdmin() || isSelf(uid);
      }
    }
  }
}
